rule RC_COMPILER__D2RLHttpsSamplePlugin_unscanned_Release
  depfile = $DEP_FILE
  deps = gcc
  command = M:/Tools/Visual Studio/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmcldeps.exe RC $in $DEP_FILE $out "Note: including file: " "M:/Tools/Visual Studio/VC/Tools/MSVC/14.51.36231/bin/Hostx64/x64/cl.exe" ${LAUNCHER}${CODE_CHECK}"M:\Tools\RE\Windows SDK\bin\10.0.26100.0\x64\rc.exe" $DEFINES $INCLUDES $FLAGS /fo $out $in
  description = Building RC object $out


