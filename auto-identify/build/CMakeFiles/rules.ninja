  command = C:\Windows\system32\cmd.exe /C "$PRE_LINK && "M:\Tools\Visual Studio\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" -E vs_link_dll --msvc-ver=1951 --intdir=$OBJECT_DIR --rc="M:\Tools\RE\Windows SDK\bin\10.0.26100.0\x64\rc.exe" --mt="M:\Tools\RE\Windows SDK\bin\10.0.26100.0\x64\mt.exe" --manifests $MANIFESTS -- "M:\Tools\Visual Studio\VC\Tools\MSVC\14.51.36231\bin\Hostx64\x64\link.exe" /nologo $in  /out:$TARGET_FILE /implib:$TARGET_IMPLIB /pdb:$TARGET_PDB /dll /version:0.0 $LINK_FLAGS $LINK_PATH $LINK_LIBRARIES && $POST_BUILD"
  description = Linking CXX shared library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for generating CXX dependencies.

rule CXX_SCAN__D2RLHttpsSamplePlugin_Release
  deps = msvc
  command = "M:\Tools\Visual Studio\VC\Tools\MSVC\14.51.36231\bin\Hostx64\x64\cl.exe" $DEFINES $INCLUDES $FLAGS $in -nologo -TP -showIncludes -scanDependencies $DYNDEP_INTERMEDIATE_FILE -Fo$OBJ_FILE
  description = Scanning $in for CXX dependencies


#############################################
# Rule to generate ninja dyndep files for CXX.

rule CXX_DYNDEP__D2RLHttpsSamplePlugin_Release
  command = "M:\Tools\Visual Studio\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" -E cmake_ninja_dyndep --tdi=PluginSDK\examples\CMakeFiles\D2RLHttpsSamplePlugin.dir\CXXDependInfo.json --lang=CXX --modmapfmt=msvc --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in
  restat = 1


#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__D2RLHttpsSamplePlugin_scanned_Release
  deps = msvc
  command = ${LAUNCHER}${CODE_CHECK}"M:\Tools\Visual Studio\VC\Tools\MSVC\14.51.36231\bin\Hostx64\x64\cl.exe"  /nologo /TP $DEFINES $INCLUDES $FLAGS /showIncludes @$DYNDEP_MODULE_MAP_FILE /Fo$out /Fd$TARGET_COMPILE_PDB /FS -c $in
  description = Building CXX object $out


#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__D2RLHttpsSamplePlugin_unscanned_Release
  deps = msvc
  command = ${LAUNCHER}${CODE_CHECK}"M:\Tools\Visual Studio\VC\Tools\MSVC\14.51.36231\bin\Hostx64\x64\cl.exe"  /nologo /TP $DEFINES $INCLUDES $FLAGS /showIncludes /Fo$out /Fd$TARGET_COMPILE_PDB /FS -c $in
  description = Building CXX object $out


#############################################
