rule RERUN_CMAKE
  command = "M:\Tools\Visual Studio\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" --regenerate-during-build -SM:\Tools\RE\d2rl-plugins\auto-identify -BM:\Tools\RE\d2rl-plugins\auto-identify\build
  description = Re-running CMake...
  generator = 1


#############################################
